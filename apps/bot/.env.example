# Copy to apps/bot/.env.local. Never commit populated files.
# demo = in-memory fixture; api = Express API with durable Supabase drafts.
BOT_MODE=demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Required by the Vercel webhook; letters, digits, underscore and hyphen only.
TELEGRAM_WEBHOOK_SECRET=
# Required only in api mode. Use HTTPS except on localhost.
CRM_API_URL=http://127.0.0.1:3001
# This must match BOT_API_TOKEN in the API project.
CRM_API_TOKEN=
# Limits applied before handing voice metadata to the backend.
BOT_MAX_VOICE_BYTES=10485760
BOT_MAX_VOICE_SECONDS=300
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
